FROM node:22-alpine AS build
WORKDIR /app
COPY src/Presentation/BallastLane.Web/package*.json ./
RUN npm ci
COPY src/Presentation/BallastLane.Web/ ./
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ballast-lane-web/browser /usr/share/nginx/html
EXPOSE 80
