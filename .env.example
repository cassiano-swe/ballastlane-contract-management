# Copy to .env for Docker Compose; supply your own local values.
POSTGRES_DB=ballastlane
POSTGRES_USER=ballastlane
POSTGRES_PASSWORD=replace-with-local-password
JWT_ISSUER=local-issuer
JWT_AUDIENCE=local-audience
# Replace with your own random secret of at least 32 UTF-8 bytes.
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes
